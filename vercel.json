{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/chi-siamo",
      "destination": "/#chi-siamo",
      "permanent": true
    },
    {
      "source": "/contatti",
      "destination": "/#contatti",
      "permanent": true
    },
    {
      "source": "/corsi",
      "destination": "/#servizi",
      "permanent": true
    },
    {
      "source": "/fauna",
      "destination": "/#servizi",
      "permanent": true
    },
    {
      "source": "/biometria(.*)",
      "destination": "/#servizi",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/#news",
      "permanent": true
    },
    {
      "source": "/blog-detail",
      "destination": "/#news",
      "permanent": true
    },
    {
      "source": "/articolo",
      "destination": "/#news",
      "permanent": true
    },
    {
      "source": "/news",
      "destination": "/#news",
      "permanent": true
    },
    {
      "source": "/galleria",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en-US",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en-us",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en-US/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en-US/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en-us/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/product-detail",
      "destination": "/#servizi",
      "permanent": true
    },
    {
      "source": "/fauna-selvatica",
      "destination": "/#servizi",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xsl",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/xsl; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/((?!materiali/).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/Pannello(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/materiali/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://nuova-piattaforma-corsi-scuola-faun.vercel.app https://*.vercel.app"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
